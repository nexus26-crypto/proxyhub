# ==== App ====
APP_NAME=ProxyHub
ENV=development
DEBUG=true

# ==== PostgreSQL ====
POSTGRES_USER=proxyhub
POSTGRES_PASSWORD=proxyhub
POSTGRES_DB=proxyhub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==== Redis ====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ==== Auth / JWT ====
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ==== Admin seed (criado automaticamente no primeiro start) ====
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@proxyhub.com
ADMIN_PASSWORD=admin123

# ==== Scheduler ====
PROXY_HEALTHCHECK_INTERVAL_SECONDS=300
PROXY_TEST_URL=https://httpbin.org/ip
PROXY_TEST_TIMEOUT_SECONDS=10

# ==== Gateway de Proxy Rotativo ====
# Seu bot/script deve usar: http://GATEWAY_USERNAME:GATEWAY_PASSWORD@<ip_da_vps>:8080
GATEWAY_PORT=8080
GATEWAY_USERNAME=gateway
GATEWAY_PASSWORD=troque-esta-senha
GATEWAY_MAX_RETRIES=3

# ==== CORS ====
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ==== Frontend ====
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
